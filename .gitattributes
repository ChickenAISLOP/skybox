# Normalise to LF in the repository so diffs stay stable across machines.
* text=auto eol=lf

*.lua   text eol=lf
*.py    text eol=lf
*.vbs   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.md    text eol=lf

*.dds   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.glb   binary
*.zip   binary

# Repository metadata, not part of a distributable archive.
.gitattributes export-ignore
.gitignore     export-ignore