# Source images. These are baked into input/dds/generated by the in-game
# generator; the game never reads PNG or JPG directly.
input/png/*
!input/png/.gitkeep
input/jpg/*
!input/jpg/.gitkeep

# Generator build artefacts
tools/__pycache__/
*.pyc

# Generator runtime state
tools/*.log
tools/*.lock
tools/*.status
tools/*.last_result

# OS noise
Thumbs.db
.DS_Store
desktop.ini